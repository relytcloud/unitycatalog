# Rendered by deploy-uc.sh from deploy/uc.env — DO NOT edit the rendered output by hand.
# Placeholders of the form dollar-brace VAR are substituted with values from uc.env.
server.env=dev

## Authorization (enable for per-user token-exchange; disable to turn auth off)
server.authorization=${UC_AUTHORIZATION}
# Server-hosted browser login (issue #15). Leave all four blank to turn the flow off; set all four
# to enable "Sign in with Microsoft" in the UI. The client secret never leaves the server.
server.authorization-url=${UC_AUTHORIZATION_URL}
server.token-url=${UC_TOKEN_URL}
server.client-id=${UC_CLIENT_ID}
server.client-secret=${UC_CLIENT_SECRET}
server.redirect-port=
# Browser-facing base URL of this server, used to build the OAuth redirect_uri. Optional: when
# blank it is derived from X-Forwarded-Proto/Host (set by the UI proxy) or the request's Host.
server.external-url=${UC_EXTERNAL_URL}
# Password for the built-in "admin" account's UI sign-in (issue #15). Blank = administrator sign-in
# off. The UI's entry point is <ui>/login/admin; it is deliberately not linked from the login page.
server.admin-password=${UC_ADMIN_PASSWORD}

# OPTIONAL extra trusted issuers (comma-separated). Trusted issuers are derived primarily from the
# JWKS file below (each key's "issuer" member, hot-reloaded); this list is a UNION on top, only for
# issuers NOT in the local JWKS (e.g. OIDC discovery), and is a startup snapshot (changing needs a
# restart). Leave empty to be governed entirely by the JWKS (recommended for Relyt).
server.allowed-issuers=${UC_ALLOWED_ISSUERS}
# Expected JWT audiences (must match the subject_token aud).
server.audiences=${UC_AUDIENCES}

server.cookie-timeout=P5D
server.managed-table.enabled=false

#### AWS (unused in this deployment; left to DefaultCredentialsProvider)
aws.masterRoleArn=
aws.accessKey=
aws.secretKey=
aws.region=

#####################################################################
# Relyt fork additions (not in upstream UC v0.4.1)
#####################################################################

# Static JWKS of the issuers above. Each key carries an "issuer" member and is only accepted for
# that issuer (kid + issuer binding). Hot-reloaded; no restart needed for key add/rotate.
server.external-jwks-file=${UC_EXTERNAL_JWKS_FILE}
# Access-token lifetime for token-exchange (ISO-8601). Opt-in: leave blank for no expiry.
server.access-token-ttl=${UC_ACCESS_TOKEN_TTL}

# Aliyun OSS — master RAM identity used by the STS AssumeRole mode.
aliyun.region=${ALIYUN_REGION}
aliyun.accessKey=${ALIYUN_ACCESS_KEY}
aliyun.secretKey=${ALIYUN_SECRET_KEY}
aliyun.masterRoleArn=${ALIYUN_MASTER_ROLE_ARN}
