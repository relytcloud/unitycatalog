# Copy to uc.env and fill in. uc.env holds real secrets and is gitignored — never commit it.
#
#   cp uc.env.example uc.env && edit uc.env
#   ./deploy-uc.sh

# --- Persistent root ---
# Point this at a persistent (cloud-disk) path. server.properties, hibernate.properties,
# relyt_jwks.json and the H2 metastore DB all live under it, so nothing is lost on restart.
# Default if unset: the UC install root (one level up from deploy/).
UC_HOME=

# --- Listen port ---
# Port the UC server listens on. 8088 matches bin/start-uc-with-ui.sh and the phoenix/presto e2e
# suites; change it only if you have a conflict. An explicit --port passed to deploy-uc.sh wins.
UC_PORT=8088

# --- Auth / token-exchange ---
# enable = require auth (per-user token-exchange); disable = no auth.
UC_AUTHORIZATION=enable
# OPTIONAL extra trusted issuers, comma-separated. Trust is derived primarily from the JWKS file
# (each key's "issuer" member, hot-reloaded); this list is a UNION on top, only for issuers NOT in
# the local JWKS (e.g. OIDC discovery). Leave EMPTY to be governed entirely by the JWKS -- the
# recommended default for Relyt (onboard a DWSU by appending its key to the JWKS: no restart, no
# change here).
UC_ALLOWED_ISSUERS=
# Expected audience of the subject tokens (must match the signer's unity.audience).
UC_AUDIENCES=unitycatalog-server
# Exchanged access-token TTL (ISO-8601). The server treats a blank value as "never expires";
# this sample ships PT1H (1 hour) on purpose — keep it unless you have a reason to opt out.
UC_ACCESS_TOKEN_TTL=PT1H

# --- Aliyun OSS (master RAM identity for STS AssumeRole) ---
ALIYUN_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY=<your-aliyun-access-key-id>
ALIYUN_SECRET_KEY=<your-aliyun-access-key-secret>
# The master RAM principal the UC server runs as. Despite the ROLE in the variable name, this is
# normally the RAM *user* ARN (acs:ram::<account-id>:user/<name>) — the identity that calls
# AssumeRole — NOT the per-location role that gets assumed.
ALIYUN_MASTER_ROLE_ARN=acs:ram::<account-id>:user/<master-ram-user>

# --- Path overrides (optional) ---
# All default to under UC_HOME; set only to relocate an individual file off UC_HOME.
# UC_SERVER_PROPERTIES=$UC_HOME/etc/conf/server.properties
# UC_HIBERNATE_PROPERTIES=$UC_HOME/etc/conf/hibernate.properties
# UC_EXTERNAL_JWKS_FILE=$UC_HOME/etc/conf/relyt_jwks.json
# UC_DB_FILE=$UC_HOME/etc/db/h2db
